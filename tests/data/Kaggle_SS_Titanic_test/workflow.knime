    <config key="annotations">
        <config key="annotation_0">
            <entry key="text" type="xstring" value="&lt;p&gt;&lt;strong&gt;Implementation of ML model for Kaggle SS Titanic competition&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;This workflow shows how to prepare data, find the most important variables, train and use GBT model to predict Space Ship Titanic passengers survivability.&lt;/p&gt;&lt;p&gt;Data from the example downloaded from &lt;a target=&quot;_blank&quot; rel=&quot;ugc noopener noreferrer nofollow&quot; href=&quot;https://www.kaggle.com/competitions/titanic&quot; draggable=&quot;false&quot; title=&quot;Use &amp;quot;⌘ click&amp;quot; to follow link&quot;&gt;h&lt;/a&gt;&lt;a target=&quot;_blank&quot; rel=&quot;ugc noopener noreferrer nofollow&quot; href=&quot;https://www.kaggle.com/competitions/spaceship-titanic&quot; draggable=&quot;false&quot; title=&quot;Use &amp;quot;⌘ click&amp;quot; to follow link&quot;&gt;ttps://www.kaggle.com/competitions/titanic&lt;/a&gt;&lt;/p&gt;"/>
            <entry key="contentType" type="xstring" value="text/html"/>
            <entry key="bgcolor" type="xint" value="16777215"/>
            <entry key="x-coordinate" type="xint" value="-1565"/>
